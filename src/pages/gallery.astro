---
import Layout from '../layouts/Layout.astro';

const screenshots = [
  { src: "/screenshots/home-screen.png", alt: "Home screen with the Future Self image, XP progress and character stats", label: "Home" },
  { src: "/screenshots/home-warlord.png", alt: "Home screen of a player at the Warlord rank", label: "Warlord Rank" },
  { src: "/screenshots/training-log.png", alt: "Training calendar and workout log", label: "Training Log" },
  { src: "/screenshots/workout-log.png", alt: "Logging a workout with several exercises", label: "Log Workout" },
  { src: "/screenshots/equipment.png", alt: "Equipment screen where you dress your character in gear", label: "Equipment" },
  { src: "/screenshots/challenges.png", alt: "Daily and weekly challenges", label: "Challenges" },
  { src: "/screenshots/arena-detail.png", alt: "Details of a challenge in the Arena", label: "Arena" },
  { src: "/screenshots/team-journey.png", alt: "Team journey map showing the monsters in order", label: "Journey Map" },
  { src: "/screenshots/battle-results.png", alt: "Results screen after a team battle", label: "Battle" },
  { src: "/screenshots/team-stats.png", alt: "Team stats and roster", label: "Team Stats" },
  { src: "/screenshots/banners.png", alt: "Team banners a team can choose from", label: "Banners" },
  { src: "/screenshots/transformation.png", alt: "Future Self screen with an AI image of the goal physique", label: "Transformation" },
  { src: "/screenshots/premium-store.png", alt: "Premium Store with optional packs", label: "Premium Store" },
  { src: "/screenshots/shop-armory.png", alt: "Armory shop where you buy gear with coins", label: "Armory" },
  { src: "/screenshots/onboarding.png", alt: "First setup screens that guide a new player", label: "Onboarding" },
];
---

<Layout title="Gallery | Departure: Fitness Quest" description="Screenshots from the Departure iPhone app, showing workout logging, the team journey map, monster battles, the Future Self image, gear, challenges and the Premium Store." ogImage="/social/team-journey.jpg">
  <section class="pt-16 pb-8 lg:pt-24 lg:pb-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">See it in action.</h1>
      <p class="text-text-muted text-lg max-w-2xl mx-auto">These screenshots come from the iPhone app, from logging a workout to fighting a monster with your team.</p>
    </div>
  </section>

  <section class="pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 sm:gap-6">
        {screenshots.map(({ src, alt, label }) => (
          <div class="group cursor-pointer">
            <div class="relative bg-surface border border-surface-light/50 rounded-2xl overflow-hidden hover:border-primary/40 transition-all hover:scale-[1.02] hover:shadow-lg hover:shadow-primary/10">
              <img src={src} alt={alt} class="w-full h-auto" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity">
                <div class="absolute bottom-0 left-0 right-0 p-3">
                  <p class="text-white text-sm font-semibold">{label}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-surface/30">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl font-bold mb-4">Like what you see?</h2>
      <p class="text-text-muted mb-6">Departure is free to download on iPhone.</p>
      <a href="https://apps.apple.com/app/id6761634387" target="_blank" rel="noopener" class="inline-flex items-center justify-center bg-primary hover:bg-primary-light text-white px-8 py-3 rounded-xl font-semibold transition-colors">
            Download Free on iPhone
          </a>
    </div>
  </section>
</Layout>
