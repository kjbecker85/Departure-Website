---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const SITE_URL = 'https://departure.engagequalia.com';
const {
  title,
  description = "Departure is a fitness RPG that tracks real workouts — sets, reps, weight — and turns them into XP, ranks, equipment, and team monster battles. Free to play. Built for adults.",
  ogImage = '/social/home-screen.jpg'
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;

// Ad pixel IDs — all optional. Scripts render only when the corresponding ID is present.
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID;
const GA4_ID = import.meta.env.PUBLIC_GA4_ID;
const TIKTOK_PIXEL_ID = import.meta.env.PUBLIC_TIKTOK_PIXEL_ID;
const REDDIT_PIXEL_ID = import.meta.env.PUBLIC_REDDIT_PIXEL_ID;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/icon-circle.png" />
    <link rel="apple-touch-icon" href="/icon-circle.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="xPEynvWHmP0yolUmFviy87MNhYVDfvUIFbUIEkxf1q8" />
    <meta name="theme-color" content="#0F0F1A" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Departure: Fitness Quest" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:site" content="@departure_fitness" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Departure: Fitness Quest",
      "operatingSystem": "iOS, Android",
      "applicationCategory": "HealthApplication",
      "description": "A fitness RPG that tracks real workouts and turns them into XP, ranks, equipment, and team monster battles. Dark Souls aesthetic. Free to play.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "author": {
        "@type": "Organization",
        "name": "Qualia AI",
        "url": "https://engagequalia.com"
      },
      "url": "https://departure.engagequalia.com"
    })} />

    {/*
      First-touch UTM + click-id capture.
      Runs on every page load, stashes params into sessionStorage once per session.
      Read back by form submit handlers (waitlist, /get redirect) so attribution
      survives cross-page navigation before conversion.
    */}
    <script is:inline>
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var keys = ['utm_source','utm_medium','utm_campaign','utm_content','utm_term','gclid','fbclid','ttclid','rdt_cid'];
          var stash = {};
          var hadAny = false;
          keys.forEach(function (k) {
            var v = params.get(k);
            if (v) { stash[k] = v; hadAny = true; }
          });
          if (hadAny && !sessionStorage.getItem('departure_attribution')) {
            stash._landing_page = window.location.pathname + window.location.search;
            stash._referrer = document.referrer || '';
            stash._captured_at = new Date().toISOString();
            sessionStorage.setItem('departure_attribution', JSON.stringify(stash));
          }
        } catch (e) {}
      })();
    </script>

    {META_PIXEL_ID && (
      <script is:inline define:vars={{ METAID: META_PIXEL_ID }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', METAID);
        fbq('track', 'PageView');
      </script>
    )}

    {GA4_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
        <script is:inline define:vars={{ GAID: GA4_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', GAID, { send_page_view: true });
        </script>
      </>
    )}

    {TIKTOK_PIXEL_ID && (
      <script is:inline define:vars={{ TTID: TIKTOK_PIXEL_ID }}>
        !function (w, d, t) {w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie","holdConsent","revokeConsent","grantConsent"],ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e};ttq.load=function(e,n){var r="https://analytics.tiktok.com/i18n/pixel/events.js",o=n&&n.partner;ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=r,ttq._t=ttq._t||{},ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};n=document.createElement("script");n.type="text/javascript",n.async=!0,n.src=r+"?sdkid="+e+"&lib="+t;e=document.getElementsByTagName("script")[0];e.parentNode.insertBefore(n,e)};
          ttq.load(TTID);
          ttq.page();
        }(window, document, 'ttq');
      </script>
    )}

    {REDDIT_PIXEL_ID && (
      <script is:inline define:vars={{ RDTID: REDDIT_PIXEL_ID }}>
        !function(w,d){if(!w.rdt){var p=w.rdt=function(){p.sendEvent?p.sendEvent.apply(p,arguments):p.callQueue.push(arguments)};p.callQueue=[];var t=d.createElement("script");t.src="https://www.redditstatic.com/ads/pixel.js",t.async=!0;var s=d.getElementsByTagName("script")[0];s.parentNode.insertBefore(t,s)}}(window,document);
        rdt('init', RDTID);
        rdt('track', 'PageVisit');
      </script>
    )}
  </head>
  <body class="min-h-screen bg-bg text-text">
    <nav class="fixed top-0 w-full z-50 bg-bg/80 backdrop-blur-lg border-b border-surface-light/50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <img src="/icon-circle.png" alt="Departure" class="w-8 h-8 rounded-lg" />
          <span class="text-lg font-bold text-text">Departure</span>
        </a>
        <div class="hidden md:flex items-center gap-8">
          <a href="/features" class="text-text-muted hover:text-text transition-colors text-sm font-medium">Features</a>
          <a href="/team-leader" class="text-text-muted hover:text-text transition-colors text-sm font-medium">Team Leaders</a>
          <a href="/gallery" class="text-text-muted hover:text-text transition-colors text-sm font-medium">Gallery</a>
          <a href="/pricing" class="text-text-muted hover:text-text transition-colors text-sm font-medium">Pricing</a>
          <a href="/about" class="text-text-muted hover:text-text transition-colors text-sm font-medium">About</a>
        </div>
        <div class="flex items-center gap-3">
          <a href="/#notify" class="bg-primary hover:bg-primary-light text-white px-4 py-2 rounded-lg text-sm font-semibold transition-colors">
            Get Notified
          </a>
          <!-- Mobile menu button -->
          <button id="mobile-menu-btn" class="md:hidden text-text-muted hover:text-text" aria-label="Menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-surface-light/50 bg-bg/95 backdrop-blur-lg">
        <div class="px-4 py-4 flex flex-col gap-3">
          <a href="/features" class="text-text-muted hover:text-text py-2 text-sm font-medium">Features</a>
          <a href="/team-leader" class="text-text-muted hover:text-text py-2 text-sm font-medium">Team Leaders</a>
          <a href="/gallery" class="text-text-muted hover:text-text py-2 text-sm font-medium">Gallery</a>
          <a href="/pricing" class="text-text-muted hover:text-text py-2 text-sm font-medium">Pricing</a>
          <a href="/about" class="text-text-muted hover:text-text py-2 text-sm font-medium">About</a>
        </div>
      </div>
    </nav>

    <main class="pt-16">
      <slot />
    </main>

    <footer class="border-t border-surface-light/50 bg-surface/50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="md:col-span-2">
            <div class="flex items-center gap-2 mb-4">
              <img src="/icon-circle.png" alt="Departure" class="w-8 h-8 rounded-lg" />
              <span class="text-lg font-bold">Departure</span>
            </div>
            <p class="text-text-muted text-sm max-w-md">
              Train like a warrior. Transform like a legend. The fitness RPG that turns every workout into an epic quest.
            </p>
          </div>
          <div>
            <h4 class="font-semibold mb-3 text-sm">Product</h4>
            <div class="flex flex-col gap-2">
              <a href="/features" class="text-text-muted hover:text-text text-sm transition-colors">Features</a>
              <a href="/team-leader" class="text-text-muted hover:text-text text-sm transition-colors">Team Leaders</a>
              <a href="/gallery" class="text-text-muted hover:text-text text-sm transition-colors">Gallery</a>
              <a href="/pricing" class="text-text-muted hover:text-text text-sm transition-colors">Pricing</a>
            </div>
          </div>
          <div>
            <h4 class="font-semibold mb-3 text-sm">Company</h4>
            <div class="flex flex-col gap-2">
              <a href="/about" class="text-text-muted hover:text-text text-sm transition-colors">About</a>
              <a href="/support" class="text-text-muted hover:text-text text-sm transition-colors">Support</a>
              <a href="mailto:departure@engagequalia.com" class="text-text-muted hover:text-text text-sm transition-colors">Contact</a>
            </div>
          </div>
        </div>
        <div class="border-t border-surface-light/50 mt-8 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
          <p class="text-text-muted text-xs">&copy; {new Date().getFullYear()} Qualia AI. All rights reserved.</p>
          <div class="flex gap-4">
            <a href="/support" class="text-text-muted hover:text-text text-xs transition-colors">Support</a>
            <a href="/privacy" class="text-text-muted hover:text-text text-xs transition-colors">Privacy Policy</a>
            <a href="/terms" class="text-text-muted hover:text-text text-xs transition-colors">Terms of Service</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
