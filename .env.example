# X/Twitter API (developer.x.com → Free tier)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Instagram Graph API (developers.facebook.com)
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Ad attribution pixels (Layout.astro) — all optional.
# Each script block only renders when its ID is set, so you can fill these in
# one at a time as campaigns launch.
PUBLIC_META_PIXEL_ID=
PUBLIC_GA4_ID=
PUBLIC_TIKTOK_PIXEL_ID=
PUBLIC_REDDIT_PIXEL_ID=

# App store destinations used by /get smart redirect.
# Replace the iOS placeholder ID (id0000000000) with the real App Store ID.
# Replace the Play Store beta URL with the production URL once Android launches.
PUBLIC_APP_STORE_URL=https://apps.apple.com/us/app/departure-fitness-quest/id0000000000
PUBLIC_PLAY_STORE_URL=https://play.google.com/apps/testing/com.qualia.fitness
