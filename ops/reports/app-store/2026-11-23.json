  "versionLocalizations": {
    "1.0.3": [
      {
        "id": "5cd1a155-bec5-469e-b06f-1b229ee8ff4a",
        "description": "Departure: Fitness Quest makes working out feel like a game. Log your workouts across arms, legs, core, and cardio — and earn XP for every session. The more consistent and varied your training, the higher you rank through 12 tiers from Thrall to Allfather.                                                    \n                                                  \nSee your transformation before it happens. Upload a selfie and our AI generates an image of your future physique based on your workout plan, giving you a powerful visual of where you're headed.    \n                                                                                                  \nTeam up with friends and compete together. Create or join a team, pick a genre theme (Barbarian, Cyberpunk, Samurai, and more), set group goals, and climb the team leaderboard. Your individual effort contributes to your team's score.                                                       \n                                                                                                      \n  Features:                                                                                           \n  - Log workouts with detailed exercise tracking\n  - XP scoring system with streak and variety bonuses                                                 \n  - 24 rank tiers to progress through                                                              \n  - AI-powered future body transformation images\n  - Team creation with 18 unique genre themes   \n  - Team goals and group scoring              \n  - Social features to find and compete with friends  ",
        "locale": "en-US",
        "keywords": "fitness, workout, gym, tracker, strength training, rpg, challenge, muscle, weightlifting, cardio",
        "marketingUrl": "https://departure.engagequalia.com",
        "promotionalText": "Turn every workout into a quest. Log real lifts, earn XP, rank up from Recruit to Legend, and fight monsters with your team. Free to play.",
        "supportUrl": "https://departure.engagequalia.com/support",
        "whatsNew": " • Sign in with Apple                                                                                                                 \n  • Sign in with Google                                                                                                                \n  • Quality and stability improvements"
      }
    ]
  },
